{
  "expo": {
    "name": "권리찾기",
    "slug": "insurance-rights-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gwonri",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
