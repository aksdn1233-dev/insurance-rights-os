{
  "expo": {
    "name": "권리찾기",
    "slug": "insurance-rights-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gwonri",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "가까운 병원과 보험사를 거리순으로 보여드리기 위해 현재 위치를 사용해요."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F8FA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
